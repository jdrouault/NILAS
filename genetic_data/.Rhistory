# dplyr::full_join(intercept_corrected) %>%
dplyr::full_join(indi.cof, by = c("entryid2")) %>%
dplyr::full_join(intercept, by = c("entryid2"))
summary_table_LD <- blues_lines %>%
as.data.frame() %>%
dplyr::group_by(entryid2) %>%
dplyr::filter(14.8 <daylength_ti) %>%
dplyr::group_by(entryid2) %>%
dplyr::summarise_at(vars(env), ~ sum(!(is.na(.)))) %>%
dplyr::rename(env_LD = env)
summary_table_SD <- blues_lines%>%
as.data.frame() %>%
