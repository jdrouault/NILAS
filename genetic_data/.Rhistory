###### Regression between LD and SD but with lm model
diff_photoperiod <- blues_lines %>% #### dataset 2 to try
dplyr::mutate(Parameters = ifelse(daylength_ti < 14.8 , "SD", "LD"))%>% # 14.8 mean threshold 7 parents
dplyr::select(LAT:entryid2, Parameters, GDD_dta_em , daylength_ti, dp_name, rp_name, dp, rp) %>%
dplyr::distinct() %>%
dplyr::group_by(entryid2, Parameters) %>%
dplyr::mutate(entryid2 = as.character(entryid2),
mean_daylength= mean(daylength_ti, na.rm =T)) %>% #   Max_daylength = max(daylength_ti, na.rm =T)
dplyr::select(entryid2, mean_daylength, Parameters) %>% # Min_daylength, Max_daylength
dplyr::distinct()
regression <- blues_lines %>% #### dataset 2 to try
# dplyr::filter(!is.na(zone)) %>%
dplyr::mutate(Parameters = ifelse(daylength_ti < 14.8 , "SD", "LD"))%>%
dplyr::select(entryid2, env, Parameters, GDD_dta_em ) %>%
dplyr::distinct() %>%
dplyr::group_by(entryid2, Parameters) %>%
dplyr::full_join(diff_photoperiod) %>%
dplyr::ungroup() %>%
dplyr::group_by(entryid2) %>%
dplyr::mutate(min_daylength = min(mean_daylength),
new_mean_daylength = mean_daylength - min_daylength)
# regression <- LD_SD_1 %>%
#   dplyr::select(label.mod, Mean_LD, Mean_SD, LD_daylength, SD_daylength) %>%
#   dplyr::rename(daylength_LD = LD_daylength, daylength_SD =  SD_daylength) %>%
#   tidyr::pivot_longer(col = c(Mean_LD:daylength_SD),
#                       names_to = c(".value", "env"),
#                       names_pattern = "(.*)_(.*)")
# split the dataset by group
regression.sp <- split(regression, regression$entryid2)
# run separate `lm` on each group and store the results in a list
r <- lapply(regression.sp, function(x) do.call("lm", list(GDD_dta_em ~ new_mean_daylength,  data = x)))
# r_corrected <- lapply(regression.sp, function(x) do.call("lm", list(WangEngel_dta_em_corrected ~ new_mean_daylength,  data = x)))
# extract the coefficient of target variable
indi.cof <- sapply(r, function(x)x$coefficients[["new_mean_daylength"]])
intercept <- sapply(r, function(x)x$coefficients[["(Intercept)"]])
indi.cof <- as.data.frame(indi.cof)
intercept <- as.data.frame(intercept)
indi.cof <- tibble::rownames_to_column(indi.cof, "entryid2")
intercept <- tibble::rownames_to_column(intercept, "entryid2")
